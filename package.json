{
  "name": "itqan",
  "private": true,
  "version": "0.1.0",
  "description": "Itqan \u2014 a personal planner for daily tasks, habits and long-term goals.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "dashboard": "python3 scripts/build_dashboard.py",
    "ci:check": "python3 scripts/build_dashboard.py --check && tsc -b && vitest run && vite build",
    "build:local": "tsc -b && LOCAL=1 vite build"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/amiri-quran": "^5.3.0",
    "canvas-confetti": "^1.9.4",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.57.0",
    "motion": "^14.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.5"
  }
}
